rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'organization']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('organization' in data) || (data.organization is string && data.organization.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }
  }
}
