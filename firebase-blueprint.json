{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data for registered Bang Bin members",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "organization": {
          "type": "string",
          "description": "Optional organization or company name",
          "maxLength": 128
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents accessible only by the owner"
    }
  }
}
